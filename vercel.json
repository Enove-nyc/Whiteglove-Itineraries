{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": {
      "*": false,
      "Enove-nyc": false,
      "main": true
    }
  },
  "ignoreCommand": "if [ \"$VERCEL_ENV\" = production ] || [ \"$VERCEL_GIT_COMMIT_REF\" = main ]; then exit 1; else exit 0; fi",
  "crons": [
    { "path": "/api/cron/trip-reminders", "schedule": "0 13 * * *" },
    { "path": "/api/cron/flight-status", "schedule": "*/30 * * * *" }
  ]
}
